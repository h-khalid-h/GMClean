# GMClean Environment Variables
# Copy this file to .env.local and fill in the values

# REQUIRED in production: Session encryption key
# Generate one with: openssl rand -base64 32
ENCRYPTION_SECRET=

# OPTIONAL: Google OAuth2 credentials (for one-click Gmail login)
# Create these at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPTIONAL: Microsoft OAuth2 credentials (for one-click Outlook login)
# Create these at https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
